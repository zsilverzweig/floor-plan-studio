{
  "name": "floor-plan-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons:validate && tsc -b && vite build",
    "lint": "oxlint",
    "icons:validate": "npx tsx src/icons/validate-icons.ts",
    "preview": "vite preview",
    "firebase:deploy": "firebase deploy --only firestore:rules,storage",
    "firebase:seed": "node scripts/seed-firestore-admin.mjs",
    "firebase:hosting": "npm run build && firebase deploy --only hosting",
    "vercel:deploy": "vercel deploy --prod --yes"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "konva": "^10.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
